docs/soft-copyright/

# 系统文件
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Java / 后端
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# Node / Cocos Creator
node_modules/
library/
temp/
local/
build/
profiles/

# Python
__pycache__/
*.pyc
.venv/
venv/

# 日志与临时文件
*.log
*.tmp
runs/
启动日志.txt
停止日志.txt
静态服务器日志.txt

# 服务端构建标记（tools/ensure-server-built.ps1 自动生成，用于判断是否需要重建）
server/.last-build-stamp

# 环境与密钥（绝不提交）
.env
.env.*
*.pem
*.key
secrets/

# 编辑器/脚本临时备份（曾误入 assets 被 Cocos 当资源）
*.bak
*.bak.meta
*.orig
