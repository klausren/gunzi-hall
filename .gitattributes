# 统一文本文件换行符为 LF，避免 Windows 团队 clone 后 CRLF 污染
# （Windows 的 git 默认 autocrlf=true 会把文本文件 checkout 成 CRLF，
#   导致 bash 脚本、Java/TS 源码在跨平台协作时产生大量伪 diff 甚至运行报错）

# 源码与脚本：强制 LF
*.sh    text eol=lf
*.java  text eol=lf
*.ts    text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.scene text eol=lf
*.meta  text eol=lf
*.properties text eol=lf

# 二进制文件：不做任何换行符/编码转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.bin   binary
*.jar   binary
*.dll   binary
*.exe   binary
*.ttf   binary
*.otf   binary
*.mp3   binary
*.wav   binary
