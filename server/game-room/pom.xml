<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gunzihall</groupId>
        <artifactId>gunzi-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>game-room</artifactId>
    <packaging>jar</packaging>

    <name>game-room</name>
    <description>战斗服：Netty WebSocket 长连接 + 心跳、房间编排、bot 托管、
        Redis 牌局快照与断线重连恢复（架构 v0 T-103/T-105）。</description>

    <properties>
        <netty.version>4.1.115.Final</netty.version>
        <jackson.version>2.17.2</jackson.version>
        <lettuce.version>6.5.3.RELEASE</lettuce.version>
        <exec.mainClass>com.gunzihall.room.BotGameDemo</exec.mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.gunzihall</groupId>
            <artifactId>game-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <version>${netty.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
            <version>${lettuce.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <!-- 可用 -Dexec.mainClass=com.gunzihall.room.ServerMain 覆盖 -->
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
