<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gunzihall</groupId>
        <artifactId>gunzi-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>game-room</artifactId>
    <packaging>jar</packaging>

    <name>game-room</name>
    <description>战斗服：Netty WebSocket 长连接 + 心跳、房间编排、bot 托管、
        Redis 牌局快照与断线重连恢复（架构 v0 T-103/T-105）。</description>

    <properties>
        <netty.version>4.1.115.Final</netty.version>
        <jackson.version>2.17.2</jackson.version>
        <lettuce.version>6.5.3.RELEASE</lettuce.version>
        <exec.mainClass>com.gunzihall.room.BotGameDemo</exec.mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.gunzihall</groupId>
            <artifactId>game-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <version>${netty.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
            <version>${lettuce.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <!-- 可用 -Dexec.mainClass=com.gunzihall.room.ServerMain 覆盖 -->
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
            <!--
              【部署用】打成可独立运行的 fat jar，目标环境只需 JDK 17，无需 Maven/源码：
                  mvn -pl game-room -am package -DskipTests
                  → game-room/target/gunzi-server.jar
                  → java -jar gunzi-server.jar 8080 1001
              几个必须的 transformer / filter（少一个都可能运行时炸）：
              - ServicesResourceTransformer：合并 META-INF/services/*，Netty 靠它发现
                编解码器与原生传输实现；不合并则只有最后一份胜出
              - ManifestResourceTransformer：写 Main-Class，否则 java -jar 报"没有主清单属性"
              - 排除 *.SF/*.DSA/*.RSA：依赖 jar 自带的签名文件在合并后会失效，
                触发 "Invalid signature file digest" 直接启动失败
              - 排除 module-info.class：多个依赖各带一份，合并即冲突报错
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>gunzi-server</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.gunzihall.room.ServerMain</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
